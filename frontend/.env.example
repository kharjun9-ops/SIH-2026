# SIH26175 3D Terrain Reconstruction - Frontend Environment Configuration
# In local development: leave empty to use the Vite dev server proxy (/api -> http://localhost:8000)
# In production on Render: set to your backend URL (e.g. https://sih-2026-eqxk.onrender.com)
VITE_API_BASE_URL=

# Photorealistic 3D Tiles Providers:
# 1. Cesium ion Token (for Cesium ion photorealistic 3D assets / OSM buildings)
# Get a free token from https://ion.cesium.com/
VITE_CESIUM_ION_TOKEN=

# 2. Google Maps API Key (for Google Photorealistic 3D Tiles)
# Enable "Map Tiles API" in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=
