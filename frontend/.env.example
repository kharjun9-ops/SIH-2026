# SIH26175 3D Terrain Reconstruction - Frontend Environment Template

# Backend API URL for production deployment (e.g. on Render)
# In local development, leave empty (Vite dev server proxies /api to http://localhost:8000)
# In production on Render: set to your Render backend web service URL (e.g. https://sih26175-backend.onrender.com)
VITE_API_BASE_URL=

# Optional Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=
